# Copy this file to .env and fill in real values.
# NEVER commit .env to the repo.

# Django secret key — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-key

# HMAC secret shared with the Unity lab for code signing
HMAC_SECRET=change-me-shared-with-unity-lab

# AI provider key (server-side only; portal works fully with AI_ENABLED=false)
AI_KEY=change-me-or-leave-blank

# Set to false in production
DEBUG=True

# Allowed hosts (comma-separated), e.g. localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
